---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import ProcessSection from "@/components/sections/ProcessSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<BaseLayout
  title="Servicios"
  description="Desarrollo de software a medida, arquitectura cloud, inteligencia artificial, modernización de plataformas y staff augmentation para empresas."
  path="/servicios"
>
  <PageHeader
    eyebrow="Servicios"
    title="Soluciones de ingeniería para cada etapa de tu producto"
    description="Desde el primer prototipo hasta la operación a escala, cubrimos todo el ciclo de vida del software empresarial."
  />
  <ServicesGrid />
  <ProcessSection />
  <CTASection
    title="¿No estás seguro de qué servicio necesitas?"
    description="Cuéntanos tu contexto en una llamada de 30 minutos y te ayudamos a definir el alcance técnico correcto."
  />
</BaseLayout>
