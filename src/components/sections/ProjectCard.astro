---
import { Icon } from "astro-icon/components";
import type { Project } from "@/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryLabel: Record<Project["category"], string> = {
  web: "Web",
  cloud: "Cloud",
  ia: "Inteligencia Artificial",
  mobile: "Mobile",
};

const categoryIcon: Record<Project["category"], string> = {
  web: "layout-panel-left",
  cloud: "cloud",
  ia: "brain-circuit",
  mobile: "smartphone",
};
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-ink-700 bg-ink-800/30 transition-colors duration-300 hover:border-brand-400/40"
  data-reveal
>
  <div class="relative flex h-40 items-center justify-center overflow-hidden border-b border-ink-700 bg-grid bg-ink-900/80">
    <Icon name={`lucide:${categoryIcon[project.category]}`} class="size-10 text-ink-600 transition-colors duration-300 group-hover:text-brand-400/60" />
    <span
      class="absolute left-4 top-4 rounded-full border border-ink-600 bg-ink-950/80 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-brand-300"
    >
      {categoryLabel[project.category]}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="font-mono text-xs text-ink-400">{project.client}</p>
    <h3 class="mt-2 text-lg font-semibold text-ink-50">{project.title}</h3>
    <p class="mt-3 flex-grow text-sm text-ink-300">{project.summary}</p>

    <div class="mt-5 grid grid-cols-2 gap-3 border-t border-ink-700 pt-5">
      {
        project.metrics.map((metric) => (
          <div>
            <p class="text-xl font-semibold text-brand-300">{metric.value}</p>
            <p class="mt-0.5 text-xs text-ink-400">{metric.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {
        project.technologies.map((tech) => (
          <span class="rounded-md border border-ink-600 px-2.5 py-1 text-xs text-ink-300">{tech}</span>
        ))
      }
    </div>
  </div>
</article>
