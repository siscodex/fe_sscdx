---
import { Icon } from "astro-icon/components";
import type { IconName } from "@/types";

interface Props {
  name: string;
  icon: IconName;
}

const { name, icon } = Astro.props;
---

<div class="flex items-center gap-3">
  <span class="flex size-10 shrink-0 transform-gpu items-center justify-center rounded-lg bg-ink-900/70 p-2 will-change-transform">
    <Icon name={icon} class="size-full" />
  </span>
  <span class="text-sm font-medium text-ink-100">{name}</span>
</div>
