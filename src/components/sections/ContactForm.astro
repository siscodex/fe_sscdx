---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Button from "@/components/ui/Button.astro";

const services = [
  "Desarrollo de software a medida",
  "Infraestructura y arquitectura cloud",
  "Inteligencia artificial aplicada",
  "Modernización de plataformas",
  "Sistemas empresariales",
  "Staff augmentation",
  "Otro / no estoy seguro",
];
---

<section class="relative overflow-hidden py-24" id="contacto">
  <div class="pointer-events-none absolute bottom-0 right-0 size-[28rem] rounded-full bg-brand-500/10 blur-[120px]"></div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <SectionTitle
      align="center"
      eyebrow="Contacto"
      title="¿Tienes una idea o proyecto en mente?"
      description="Cuéntanos sobre tu necesidad técnica y te contactaremos en menos de 24 horas hábiles."
      class="mx-auto items-center text-center"
    />

    <div class="mt-10 rounded-xl border border-ink-700 bg-ink-800/40 p-6 backdrop-blur-xl sm:p-10">
      <!--
        Sin backend todavía: el formulario queda listo para integrarse con
        cualquier servicio (endpoint propio, Formspree, AWS Lambda, etc.)
        apuntando `action` a PUBLIC_CONTACT_ENDPOINT y sustituyendo el
        `preventDefault` del script por un `fetch` real.
      -->
      <form id="contact-form" class="grid grid-cols-1 gap-5 sm:grid-cols-2" novalidate>
        <div class="flex flex-col gap-2">
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-400">Nombre *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Tu nombre completo"
            class="rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="company" class="font-mono text-xs uppercase tracking-wider text-ink-400">Empresa</label>
          <input
            id="company"
            name="company"
            type="text"
            autocomplete="organization"
            placeholder="Nombre de tu empresa"
            class="rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-400">Email de trabajo *</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@empresa.com"
            class="rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="font-mono text-xs uppercase tracking-wider text-ink-400">Teléfono</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+1 (555) 000-0000"
            class="rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          />
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="service" class="font-mono text-xs uppercase tracking-wider text-ink-400">Servicio de interés</label>
          <select
            id="service"
            name="service"
            class="rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          >
            {services.map((service) => <option value={service}>{service}</option>)}
          </select>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-ink-400">
            Descripción del proyecto *
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Cuéntanos brevemente tu necesidad técnica, plazos y alcance estimado..."
            class="resize-none rounded-md border border-ink-600 bg-ink-900/60 px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-500 focus:border-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/30"
          ></textarea>
        </div>

        <div class="sm:col-span-2">
          <Button type="submit" size="lg" class="w-full justify-center">Enviar solicitud</Button>
          <p data-form-status class="mt-3 hidden text-center text-sm text-brand-300" role="status"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.querySelector<HTMLParagraphElement>("[data-form-status]");
    if (!form || !status) return;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      // TODO: sustituir por integración real (fetch a PUBLIC_CONTACT_ENDPOINT).
      status.textContent = "Gracias — hemos recibido tu solicitud. Te contactaremos pronto.";
      status.classList.remove("hidden");
      form.reset();
    });
  });
</script>
