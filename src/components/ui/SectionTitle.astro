---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className } = Astro.props;

const wrapperAlign = align === "center" ? "items-center text-center mx-auto" : "items-start text-left";
---

<div class:list={["flex max-w-2xl flex-col gap-3", wrapperAlign, className]}>
  {
    eyebrow && (
      <span class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-brand-400">
        {eyebrow}
      </span>
    )
  }
  <h2 class="text-3xl font-semibold text-ink-50 sm:text-4xl">{title}</h2>
  {description && <p class="text-base text-ink-300 sm:text-lg">{description}</p>}
</div>
