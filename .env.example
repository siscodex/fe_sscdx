# Variables públicas (expuestas al cliente vía import.meta.env — prefijo obligatorio "PUBLIC_").
# Ninguna es requerida para `npm run dev` / `npm run build`; el sitio funciona sin backend.

# Ruta base del sitio. Dejar vacío ("/") con dominio propio; usar "/nombre-del-repo"
# solo en un GitHub Pages de proyecto sin dominio personalizado.
PUBLIC_BASE_PATH=/

# Endpoint al que apuntará el formulario de contacto cuando se integre un backend
# (API propia, AWS Lambda, Formspree, etc.). No usado todavía por el código.
PUBLIC_CONTACT_ENDPOINT=
