---
import { Icon } from "astro-icon/components";
import type { Service } from "@/types";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={service.href}
  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-ink-700/80 bg-ink-800/40 p-7 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-brand-400/40"
  data-reveal
>
  <div
    class="pointer-events-none absolute right-0 top-0 size-32 rounded-bl-full bg-brand-500/0 transition-colors duration-300 group-hover:bg-brand-500/10"
  >
  </div>

  <div class="flex items-center justify-between">
    <span class="font-mono text-sm text-brand-400">{service.index}</span>
    <span
      class="flex size-11 items-center justify-center rounded-lg bg-ink-700/60 text-brand-400 transition-colors group-hover:bg-brand-400/10"
    >
      <Icon name={`lucide:${service.icon}`} class="size-5" />
    </span>
  </div>

  <h3 class="mt-5 text-lg font-semibold text-ink-50">{service.title}</h3>
  <p class="mt-3 flex-grow text-sm leading-relaxed text-ink-300">{service.description}</p>

  <ul class="mt-6 flex flex-col gap-2 border-t border-ink-700 pt-5 font-mono text-xs text-ink-400">
    {
      service.bullets.map((bullet) => (
        <li class="flex items-center gap-2">
          <span class="text-brand-400/60">–</span>
          {bullet}
        </li>
      ))
    }
  </ul>
</a>
