---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import SpecialtiesTabs from "@/components/sections/SpecialtiesTabs.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<BaseLayout
  title="Soluciones"
  description="Áreas de especialidad de Siscodex: cloud, inteligencia artificial, aplicaciones móviles y desarrollo web, aplicadas en distintas industrias."
  path="/soluciones"
>
  <PageHeader
    eyebrow="Soluciones"
    title="Especialización respaldada por experiencia real"
    description="Nuestra experiencia en distintas industrias nos permite combinar ingeniería de software, arquitectura cloud e inteligencia artificial para transformar desafíos complejos en soluciones eficientes, escalables y de alto impacto."
  />
  <SpecialtiesTabs />
  <CTASection
    title="¿Tienes un reto similar?"
    description="Hablemos sobre cómo aplicar el mismo nivel de ingeniería a tu proyecto."
    secondaryCta={{ label: "Ver servicios", href: "/servicios" }}
  />
</BaseLayout>
