---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import ProjectsGrid from "@/components/sections/ProjectsGrid.astro";
import CTASection from "@/components/sections/CTASection.astro";
---

<BaseLayout
  title="Soluciones"
  description="Casos de referencia de Siscodex: plataformas cloud, inteligencia artificial aplicada, apps móviles y portales B2B para empresas."
  path="/soluciones"
>
  <PageHeader
    eyebrow="Soluciones"
    title="Resultados medibles, no solo líneas de código"
    description="Cada proyecto se diseña alrededor de un objetivo de negocio concreto: reducir costos, acelerar operaciones o abrir nuevos canales."
  />
  <ProjectsGrid />
  <CTASection
    title="¿Tienes un reto similar?"
    description="Hablemos sobre cómo aplicar el mismo nivel de ingeniería a tu proyecto."
    secondaryCta={{ label: "Ver servicios", href: "/servicios" }}
  />
</BaseLayout>
