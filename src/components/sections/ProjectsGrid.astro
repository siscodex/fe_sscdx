---
import ProjectCard from "@/components/sections/ProjectCard.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Button from "@/components/ui/Button.astro";
import { projects } from "@/data/projects";

interface Props {
  limit?: number;
  showCta?: boolean;
}

const { limit, showCta = false } = Astro.props;
const items = limit ? projects.slice(0, limit) : projects;
---

<section class="border-y border-ink-700 bg-ink-900/60 py-24" id="proyectos">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <SectionTitle
      eyebrow="Experiencia"
      title="Proyectos que respaldan nuestra ingeniería"
      description="Una muestra de los retos técnicos que hemos resuelto para empresas de distintas industrias."
    />

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {items.map((project) => <ProjectCard project={project} />)}
    </div>

    {
      showCta && (
        <div class="mt-12 flex justify-center">
          <Button href="/soluciones" variant="secondary" icon="arrow-right">
            Ver todas las soluciones
          </Button>
        </div>
      )
    }
  </div>
</section>
